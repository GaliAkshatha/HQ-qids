# QIDS backend environment variables. Copy to .env for local overrides
# (never commit a real .env -- it's already in .gitignore).

# --- Redis ---
# Preferred for managed Redis (Upstash, Redis Cloud, Render Redis, etc.)
# -- takes precedence over REDIS_HOST/REDIS_PORT below when set.
# Format: redis://[:password@]host:port/db  or  rediss://... for TLS.
REDIS_URL=

# Fallback if REDIS_URL is unset (used by local dev / Docker Compose):
REDIS_HOST=localhost
REDIS_PORT=6379

# --- API ---
# Port the Flask/gunicorn API listens on. Most PaaS platforms inject
# this automatically -- only set it yourself for manual deployments.
PORT=8080

# Comma-separated list of frontend origins allowed to call this API.
# Leave unset for local development (defaults to allow-all, matching
# existing local-dev behavior). Set explicitly in production, e.g.:
# CORS_ALLOWED_ORIGINS=https://qids.vercel.app,https://qids-staging.vercel.app
CORS_ALLOWED_ORIGINS=

# --- Incident event store ---
# "jsonl" (default) or "redis". Use "redis" on platforms with an
# ephemeral/non-persistent filesystem so incident history survives
# restarts and redeploys.
EVENT_STORE_BACKEND=jsonl

# Only used when EVENT_STORE_BACKEND=jsonl. Must point at a writable,
# ideally persistent, directory on the deployed backend.
EVENT_STORE_PATH=logs/api_incident_events.jsonl
